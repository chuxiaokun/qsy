.subpage {
  position: relative;
  min-height: 100vh;
  background: #F0FAFF;
}

.sub-bg {
  position: fixed;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, #D8F3FF 0%, #E0F2FE 260rpx, #F0FAFF 520rpx, #F0FAFF 100%),
    linear-gradient(135deg, rgba(14, 165, 233, 0.12), rgba(18, 50, 74, 0.08));
}

.sub-main {
  position: relative;
  z-index: 1;
  padding: 20rpx 28rpx 48rpx;
}

.sub-nav {
  display: flex;
  align-items: center;
  height: 92rpx;
  margin-bottom: 20rpx;
}

.sub-nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 12rpx;
  color: #12324A;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(18, 50, 74, 0.08);
  border-radius: 16rpx;
}

.sub-nav-title {
  flex: 1;
  color: #12324A;
  font-size: 34rpx;
  font-weight: 800;
}

.sub-nav-action {
  color: #0EA5E9;
  font-size: 26rpx;
  font-weight: 700;
}

.glass {
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(18, 50, 74, 0.08);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}

.rounded-2xl {
  border-radius: 16rpx;
}

.shadow-soft {
  box-shadow: 0 14rpx 34rpx rgba(18, 50, 74, 0.08), 0 6rpx 18rpx rgba(14, 165, 233, 0.08);
}

.gradient-bg {
  background: linear-gradient(135deg, #0EA5E9 0%, #38BDF8 52%, #7DD3FC 100%);
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  color: #12324A;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 16rpx;
}

.primary-btn.is-disabled {
  opacity: 0.55;
}

.outline-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  color: #12324A;
  font-size: 30rpx;
  font-weight: 600;
  background: #E0F2FE;
  border: 2rpx solid rgba(56, 189, 248, 0.34);
  border-radius: 16rpx;
}

.card-block {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.empty-wrap {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-title {
  display: block;
  margin-bottom: 12rpx;
  color: #12324A;
  font-size: 32rpx;
  font-weight: 600;
}

.empty-desc {
  display: block;
  color: #5E7A8C;
  font-size: 26rpx;
  line-height: 1.6;
}

.badge-tag {
  display: inline-flex;
  padding: 4rpx 12rpx;
  color: #12324A;
  font-size: 22rpx;
  background: #E0F2FE;
  border-radius: 999rpx;
}

.badge-live {
  color: #0F6B93;
  background: rgba(56, 189, 248, 0.18);
}

.progress-wrap {
  margin-top: 20rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: #5E7A8C;
  font-size: 24rpx;
}

.progress-track {
  height: 12rpx;
  overflow: hidden;
  background: rgba(18, 50, 74, 0.1);
  border-radius: 999rpx;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #0EA5E9, #38BDF8, #7DD3FC);
  border-radius: 999rpx;
  transition: width 0.2s ease;
}

.icon {
  display: inline-block;
  position: relative;
  width: 40rpx;
  height: 40rpx;
  color: inherit;
  flex-shrink: 0;
  line-height: 1;
  vertical-align: middle;
  transform-origin: center;
}

.icon::before,
.icon::after {
  box-sizing: border-box;
  pointer-events: none;
  transform-origin: center;
}

.icon-back::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid #12324A;
  border-bottom: 4rpx solid #12324A;
  transform: rotate(45deg);
}

.icon-primary {
  color: #0EA5E9;
}

.icon-muted {
  color: #5E7A8C;
}

.icon-white {
  color: #fff;
}

.icon-chevron-right::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.icon-live::before {
  content: "";
  position: absolute;
  inset: 8rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.icon-live::after {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 12rpx;
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 12rpx solid currentColor;
}

.icon-convert::before {
  content: "";
  position: absolute;
  inset: 6rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
}

.icon-convert::after {
  content: "";
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
}
