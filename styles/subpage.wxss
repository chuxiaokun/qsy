.subpage {
  position: relative;
  min-height: 100vh;
  background: #f7fcfa;
}

.sub-bg {
  position: fixed;
  inset: 0;
  pointer-events: none;
}

.sub-bg::before,
.sub-bg::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  filter: blur(64rpx);
}

.sub-bg::before {
  top: -200rpx;
  right: -180rpx;
  width: 480rpx;
  height: 480rpx;
  background: rgba(64, 199, 159, 0.12);
}

.sub-bg::after {
  bottom: 120rpx;
  left: -200rpx;
  width: 520rpx;
  height: 520rpx;
  background: rgba(137, 222, 235, 0.18);
}

.sub-main {
  position: relative;
  z-index: 1;
  padding: 24rpx 32rpx 48rpx;
}

.sub-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-bottom: 24rpx;
}

.sub-nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 8rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
}

.sub-nav-title {
  flex: 1;
  color: #2f3b39;
  font-size: 36rpx;
  font-weight: 700;
}

.sub-nav-action {
  color: #35bd94;
  font-size: 26rpx;
  font-weight: 500;
}

.glass {
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.54);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
}

.rounded-2xl {
  border-radius: 32rpx;
}

.shadow-soft {
  box-shadow: 0 8rpx 40rpx -4rpx rgba(78, 137, 128, 0.16), 0 4rpx 16rpx -4rpx rgba(78, 137, 128, 0.12);
}

.gradient-bg {
  background: linear-gradient(135deg, #58cfa3 0%, #83d6e5 100%);
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 24rpx;
}

.primary-btn.is-disabled {
  opacity: 0.55;
}

.outline-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  color: #35bd94;
  font-size: 30rpx;
  font-weight: 600;
  background: rgba(53, 189, 148, 0.1);
  border-radius: 24rpx;
}

.card-block {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.empty-wrap {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-title {
  display: block;
  margin-bottom: 12rpx;
  color: #2f3b39;
  font-size: 32rpx;
  font-weight: 600;
}

.empty-desc {
  display: block;
  color: #76827f;
  font-size: 26rpx;
  line-height: 1.6;
}

.badge-tag {
  display: inline-flex;
  padding: 4rpx 12rpx;
  color: #35bd94;
  font-size: 22rpx;
  background: rgba(53, 189, 148, 0.12);
  border-radius: 999rpx;
}

.badge-live {
  color: #d97706;
  background: rgba(245, 158, 11, 0.14);
}

.progress-wrap {
  margin-top: 20rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: #76827f;
  font-size: 24rpx;
}

.progress-track {
  height: 12rpx;
  overflow: hidden;
  background: rgba(53, 189, 148, 0.12);
  border-radius: 999rpx;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #58cfa3, #83d6e5);
  border-radius: 999rpx;
  transition: width 0.2s ease;
}

.icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}

.icon-back::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid #76827f;
  border-bottom: 4rpx solid #76827f;
  transform: rotate(45deg);
}

.icon-primary {
  color: #35bd94;
}

.icon-muted {
  color: #76827f;
}

.icon-white {
  color: #fff;
}

.icon-chevron-right::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.icon-live::before {
  content: "";
  position: absolute;
  inset: 8rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.icon-live::after {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 12rpx;
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 12rpx solid currentColor;
}

.icon-convert::before {
  content: "";
  position: absolute;
  inset: 6rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
}

.icon-convert::after {
  content: "";
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
}
