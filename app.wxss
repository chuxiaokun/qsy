page {
  min-height: 100vh;
  color: #12324A;
  background: #F0FAFF;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: normal;
  background: transparent;
  border: 0;
  border-radius: 0;
}

button::after {
  display: none;
}

.profile-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(18, 50, 74, 0.5);
}

.profile-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 44rpx 36rpx 36rpx;
  box-sizing: border-box;
}

.profile-modal-title {
  display: block;
  color: #12324A;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.profile-modal-desc {
  display: block;
  margin-top: 16rpx;
  margin-bottom: 32rpx;
  color: #5E7A8C;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.profile-modal-save {
  width: 100%;
  height: 88rpx;
  margin-bottom: 16rpx;
  color: #12324A;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  background: linear-gradient(135deg, #0EA5E9 0%, #38BDF8 52%, #7DD3FC 100%);
  border: none;
  border-radius: 16rpx;
}

.profile-modal-save-outline {
  color: #0EA5E9;
  background: #FFFFFF;
  border: 2rpx solid rgba(56, 189, 248, 0.38);
}

.profile-modal-skip {
  width: 100%;
  height: 72rpx;
  color: #5E7A8C;
  font-size: 28rpx;
  line-height: 72rpx;
  background: transparent;
  border: none;
}
