<view class="subpage">
  <view class="sub-bg"></view>
  <view class="sub-main" style="padding-top: {{statusBarHeight}}px;">
    <view class="sub-nav">
      <view class="sub-nav-back" bindtap="goBack">
        <view class="icon icon-back"></view>
      </view>
      <text class="sub-nav-title">Live Photo</text>
    </view>

    <view class="glass rounded-2xl shadow-soft card-block tip-card">
      <view class="icon icon-live icon-primary tip-icon"></view>
      <view class="tip-text">
        <text class="tip-title">保存 Live Photo</text>
        <text class="tip-desc">将同时保存静态封面与动态视频到相册。解析小红书等平台图集时，若接口返回 live_photo_url 即可使用。</text>
      </view>
    </view>

    <view wx:if="{{!items.length}}" class="glass rounded-2xl shadow-soft empty-wrap">
      <text class="empty-title">暂无可保存的 Live</text>
      <text class="empty-desc">请先解析包含 Live Photo 的图集链接，记录会自动出现在这里</text>
      <button class="primary-btn gradient-bg shadow-soft empty-btn" bindtap="goParse">去解析链接</button>
    </view>

    <view wx:else class="live-list">
      <view class="glass rounded-2xl shadow-soft card-block live-item" wx:for="{{items}}" wx:key="id">
        <image class="live-thumb" src="{{item.previewUrl}}" mode="aspectFill" />
        <view class="live-copy">
          <text class="live-title">{{item.title}}</text>
          <text class="live-time">{{item.timeLabel}}</text>
        </view>
        <button
          class="live-save-btn gradient-bg {{savingId === item.id ? 'is-disabled' : ''}}"
          data-id="{{item.id}}"
          bindtap="saveItem"
          disabled="{{savingId === item.id}}"
        >
          {{savingId === item.id ? '保存中' : '保存'}}
        </button>
      </view>
      <button class="outline-btn batch-btn {{savingId === 'all' ? 'is-disabled' : ''}}" bindtap="saveAll" disabled="{{savingId}}">
        {{savingId === 'all' ? '批量保存中...' : '全部保存到相册'}}
      </button>
    </view>

    <view wx:if="{{showProgress}}" class="glass rounded-2xl shadow-soft card-block progress-wrap">
      <view class="progress-head">
        <text>正在保存 Live Photo</text>
        <text>{{progress}}%</text>
      </view>
      <view class="progress-track">
        <view class="progress-bar" style="width: {{progress}}%;"></view>
      </view>
    </view>
  </view>
</view>
