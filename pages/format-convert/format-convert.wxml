<view class="subpage">
  <view class="sub-bg"></view>
  <view class="sub-main" style="padding-top: {{statusBarHeight}}px;">
    <view class="sub-nav">
      <view class="sub-nav-back" bindtap="goBack">
        <view class="icon icon-back"></view>
      </view>
      <text class="sub-nav-title">格式转换</text>
    </view>

    <view class="mode-tabs glass rounded-2xl shadow-soft">
      <button class="mode-tab {{mode === 'heic' ? 'mode-tab-active' : ''}}" data-mode="heic" bindtap="switchMode">HEIC → JPG</button>
      <button class="mode-tab {{mode === 'gif' ? 'mode-tab-active' : ''}}" data-mode="gif" bindtap="switchMode">视频 → GIF</button>
    </view>

    <view class="glass rounded-2xl shadow-soft card-block convert-card">
      <view wx:if="{{mode === 'heic'}}">
        <text class="convert-title">图片格式转换</text>
        <text class="convert-desc">从相册选择 HEIC 或其他图片，导出为 JPG 并保存到相册</text>
        <view wx:if="{{previewPath}}" class="preview-wrap">
          <image class="preview-image" src="{{previewPath}}" mode="aspectFit" />
        </view>
        <button class="primary-btn gradient-bg shadow-soft {{isConverting ? 'is-disabled' : ''}}" bindtap="chooseHeic" disabled="{{isConverting}}">
          {{previewPath ? (isConverting ? '转换中...' : '重新选择并转换') : '选择图片并转换'}}
        </button>
      </view>

      <view wx:else>
        <text class="convert-title">视频转 GIF</text>
        <text class="convert-desc">可自定义截取时长与帧率；GIF 将保持原视频宽高比例与尺寸。</text>
        <view class="gif-settings">
          <view class="setting-row">
            <text class="setting-label">截取时长</text>
            <text class="setting-value">{{gifDuration}} 秒</text>
          </view>
          <slider min="1" max="6" step="1" value="{{gifDuration}}" bindchange="onGifDurationChange" activeColor="#0EA5E9" block-color="#0EA5E9" />

          <view class="setting-row">
            <text class="setting-label">帧率</text>
            <text class="setting-value">{{gifFps}} fps</text>
          </view>
          <slider min="4" max="12" step="1" value="{{gifFps}}" bindchange="onGifFpsChange" activeColor="#0EA5E9" block-color="#0EA5E9" />
          <text wx:if="{{selectedVideoDuration}}" class="setting-tip">本次视频时长约 {{selectedVideoDuration}} 秒，将按上方参数截取。</text>
        </view>
        <view wx:if="{{gifPreviewPath}}" class="preview-wrap">
          <image class="preview-image" src="{{gifPreviewPath}}" mode="aspectFit" />
        </view>
        <button class="primary-btn gradient-bg shadow-soft {{isConverting ? 'is-disabled' : ''}}" bindtap="chooseVideo" disabled="{{isConverting}}">
          {{isConverting ? '转换中 ' + progress + '%' : '选择视频并转换'}}
        </button>
        <button wx:if="{{gifPreviewPath}}" class="primary-btn shadow-soft {{isConverting ? 'is-disabled' : ''}}" bindtap="saveGifToAlbum" disabled="{{isConverting}}">
          保存到相册
        </button>
      </view>

      <view wx:if="{{showProgress}}" class="progress-wrap">
        <view class="progress-head">
          <text>{{progressLabel}}</text>
          <text>{{progress}}%</text>
        </view>
        <view class="progress-track">
          <view class="progress-bar" style="width: {{progress}}%;"></view>
        </view>
      </view>
    </view>

    <canvas type="2d" id="convertCanvas" class="hidden-canvas" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"></canvas>
  </view>
</view>
