@import "../../styles/subpage.wxss";

.mode-tabs {
  display: flex;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  flex: 1;
  height: 80rpx;
  color: #5E7A8C;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 14rpx;
}

.mode-tab-active {
  color: #fff;
  background: linear-gradient(135deg, #0EA5E9, #38BDF8);
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.18);
}

.convert-title {
  display: block;
  margin-bottom: 12rpx;
  color: #12324A;
  font-size: 32rpx;
  font-weight: 600;
}

.convert-desc {
  display: block;
  margin-bottom: 28rpx;
  color: #5E7A8C;
  font-size: 26rpx;
  line-height: 1.6;
}

.preview-wrap {
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(18, 50, 74, 0.06);
  border-radius: 16rpx;
}

.preview-image {
  width: 100%;
  height: 360rpx;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}
