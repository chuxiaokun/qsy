@import "../../styles/subpage.wxss";

.search-card {
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}

.search-input {
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
}

.history-actions {
  flex-shrink: 0;
}

.mini-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 9999px;
  font-size: 24rpx;
  color: #0EA5E9;
  background: rgba(14, 165, 233, 0.08);
  border: 1rpx solid rgba(14, 165, 233, 0.15);
}

