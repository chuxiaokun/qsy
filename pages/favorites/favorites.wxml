<view class="subpage">
  <view class="sub-bg"></view>
  <view class="sub-main" style="padding-top: {{statusBarHeight}}px;">
    <view class="sub-nav">
      <view class="sub-nav-back" bindtap="goBack">
        <view class="icon icon-back"></view>
      </view>
      <text class="sub-nav-title">我的收藏</text>
      <text wx:if="{{list.length}}" class="sub-nav-action" bindtap="clearAll">清空</text>
    </view>

    <view class="glass rounded-2xl shadow-soft search-card">
      <input
        class="search-input"
        value="{{q}}"
        placeholder="搜索标题/链接/平台"
        maxlength="60"
        bindinput="onQueryInput"
      />
    </view>

    <view wx:if="{{!list.length && !loading}}" class="glass rounded-2xl shadow-soft empty-wrap">
      <text class="empty-title">暂无收藏</text>
      <text class="empty-desc">在去水印结果页点击「收藏」即可加入这里</text>
      <button class="primary-btn gradient-bg shadow-soft empty-btn" bindtap="goParse">去解析链接</button>
    </view>

    <view wx:elif="{{loading}}" class="glass rounded-2xl shadow-soft empty-wrap">
      <text class="empty-desc">加载中…</text>
    </view>

    <view wx:else class="history-list">
      <view
        class="glass rounded-2xl shadow-soft history-item"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openDetail"
      >
        <view class="history-thumb-wrap">
          <image wx:if="{{item.previewThumbUrl}}" class="history-thumb" src="{{item.previewThumbUrl}}" mode="aspectFill" />
          <view wx:else class="history-thumb history-thumb-video">
            <view class="icon icon-star icon-primary"></view>
          </view>
        </view>
        <view class="history-copy">
          <view class="history-title-row">
            <text class="history-title">{{item.title || '未命名作品'}}</text>
            <text wx:if="{{item.platform}}" class="badge-tag badge-live">{{item.platform}}</text>
          </view>
          <text class="history-meta">{{item.typeLabel}} · {{item.timeLabel}}</text>
          <text class="history-link">{{item.sourceUrl}}</text>
        </view>
        <view class="history-actions" catchtap="noop">
          <button class="mini-btn" data-id="{{item.id}}" bindtap="removeOne">移除</button>
        </view>
      </view>
    </view>
  </view>
</view>

