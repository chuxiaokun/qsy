@import "../../styles/subpage.wxss";

.form-card {
  padding: 24rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(15, 23, 42, 0.86);
}

.form-textarea {
  margin-top: 12rpx;
  width: 100%;
  min-height: 240rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  line-height: 1.5;
}

.form-split {
  height: 1rpx;
  background: rgba(148, 163, 184, 0.22);
  margin: 22rpx 0;
}

.form-input {
  margin-top: 12rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
}

.form-btn {
  margin-top: 22rpx;
}

.form-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(15, 23, 42, 0.55);
}

