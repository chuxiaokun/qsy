@import "../../styles/subpage.wxss";

.form-card {
  padding: 40rpx 32rpx;
}

.form-tip {
  display: block;
  margin-bottom: 40rpx;
  color: #5E7A8C;
  font-size: 26rpx;
  line-height: 1.55;
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  margin-bottom: 16rpx;
  color: #12324A;
  font-size: 28rpx;
  font-weight: 500;
}

.field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  color: #12324A;
  font-size: 28rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(18, 50, 74, 0.08);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.field-placeholder {
  color: #9CB6C6;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-input {
  flex: 1;
  min-width: 0;
}

.code-btn {
  flex-shrink: 0;
  height: 96rpx;
  padding: 0 28rpx;
  color: #12324A;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 96rpx;
  background: #E0F2FE;
  border: 2rpx solid rgba(56, 189, 248, 0.34);
  border-radius: 16rpx;
}

.code-btn.is-disabled {
  opacity: 0.5;
}

.submit-btn {
  width: 100%;
  margin-top: 16rpx;
}

.submit-btn.is-disabled {
  opacity: 0.5;
}

.bound-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 8rpx;
  text-align: center;
}

.bound-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 24rpx;
  transform: scale(1.55);
  transform-origin: center;
}

.bound-email {
  color: #12324A;
  font-size: 32rpx;
  font-weight: 600;
}

.bound-hint {
  margin-top: 16rpx;
  color: #5E7A8C;
  font-size: 24rpx;
}

.icon-check::before {
  content: "";
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.icon-check::after {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 16rpx;
  width: 14rpx;
  height: 8rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(-45deg);
}

.icon {
  display: inline-block;
  position: relative;
  width: 40rpx;
  height: 40rpx;
  color: inherit;
  flex-shrink: 0;
  line-height: 1;
  vertical-align: middle;
  transform-origin: center;
}

.icon::before,
.icon::after {
  box-sizing: border-box;
  pointer-events: none;
  transform-origin: center;
}

.icon-primary {
  color: #0EA5E9;
}
