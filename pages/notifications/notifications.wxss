@import "../../styles/subpage.wxss";

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.notice-item {
  padding: 20rpx;
}

.notice-item.is-read {
  opacity: 0.86;
}

.notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
}

.notice-content {
  font-size: 26rpx;
  color: rgba(15, 23, 42, 0.7);
  line-height: 1.5;
  white-space: pre-wrap;
}

.badge-hot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 40rpx;
  padding: 0 14rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  background: linear-gradient(135deg, #0EA5E9 0%, #38BDF8 52%, #7DD3FC 100%);
  border-radius: 999rpx;
}

.profile-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(18, 50, 74, 0.5);
}

.notice-modal {
  width: 100%;
  max-width: 620rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.notice-modal-header {
  padding: 36rpx 40rpx 28rpx;
  background: linear-gradient(180deg, #f0f9ff 0%, #e0f2fe 100%);
  border-bottom: 1rpx solid rgba(56, 189, 248, 0.14);
}

.notice-modal-header-text {
  display: block;
  color: #0ea5e9;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.notice-modal-body {
  padding: 32rpx 40rpx 40rpx;
  background: rgba(255, 255, 255, 0.96);
}

.notice-modal-content {
  display: block;
  color: #5e7a8c;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.notice-modal-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 36rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  border: none;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 52%, #7dd3fc 100%);
}

.notice-modal-btn::after {
  border: none;
}

