@import "../../styles/subpage.wxss";

.convert-title {
  display: block;
  margin-bottom: 12rpx;
  color: #12324A;
  font-size: 32rpx;
  font-weight: 600;
}

.convert-desc {
  display: block;
  margin-bottom: 28rpx;
  color: #5E7A8C;
  font-size: 26rpx;
  line-height: 1.6;
}

.settings {
  margin-bottom: 24rpx;
  padding: 18rpx 18rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(14, 165, 233, 0.06);
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.setting-label {
  color: #2A4458;
  font-size: 26rpx;
  font-weight: 600;
}

.setting-value {
  color: #0EA5E9;
  font-size: 24rpx;
  font-weight: 600;
}

slider {
  margin: 8rpx 0 12rpx;
}

.picker-value {
  min-width: 150rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(14, 165, 233, 0.35);
  color: #0EA5E9;
  text-align: center;
  font-size: 24rpx;
}

.setting-tip {
  display: block;
  margin-top: 6rpx;
  color: #5E7A8C;
  font-size: 22rpx;
}

.preview-wrap {
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(18, 50, 74, 0.06);
  border-radius: 16rpx;
}

.preview-image {
  width: 100%;
  height: 360rpx;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

