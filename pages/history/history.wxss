@import "../../styles/subpage.wxss";

.icon-video::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 10rpx;
  width: 24rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
}

.icon-video::after {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 14rpx;
  width: 0;
  height: 0;
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  border-left: 10rpx solid currentColor;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
}

.history-thumb-wrap {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #E0F2FE;
}

.history-thumb {
  width: 100%;
  height: 100%;
}

.history-thumb-video {
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-copy {
  flex: 1;
  min-width: 0;
}

.history-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.history-title {
  flex: 1;
  overflow: hidden;
  color: #12324A;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-meta {
  display: block;
  margin-bottom: 6rpx;
  color: #5E7A8C;
  font-size: 24rpx;
}

.history-link {
  display: block;
  overflow: hidden;
  color: #9aa5a2;
  font-size: 22rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.empty-btn {
  margin-top: 40rpx;
}
