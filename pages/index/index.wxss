/* VIP profile polish */
.vip-crown-badge {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  color: #7C3F00;
  background:
    radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.95) 0 10rpx, rgba(255, 255, 255, 0) 11rpx),
    linear-gradient(135deg, #FFF4B8 0%, #FACC15 42%, #F59E0B 100%);
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-shadow: 0 8rpx 18rpx rgba(180, 83, 9, 0.24), 0 0 18rpx rgba(250, 204, 21, 0.38);
}

.vip-crown-icon {
  width: 40rpx;
  height: 40rpx;
  transform: scale(0.68);
}

.member-soon-card {
  position: relative;
  overflow: hidden;
  color: #6B3A00;
  background:
    radial-gradient(circle at 88% 0%, rgba(255, 255, 255, 0.58) 0, rgba(255, 255, 255, 0) 138rpx),
    linear-gradient(135deg, #FFF7C2 0%, #FDE68A 34%, #FBBF24 70%, #F59E0B 100%);
  border: 2rpx solid rgba(245, 158, 11, 0.42);
  box-shadow: 0 16rpx 36rpx rgba(180, 83, 9, 0.16), 0 8rpx 22rpx rgba(250, 204, 21, 0.16);
}

.member-soon-card::before {
  content: "";
  position: absolute;
  top: -80rpx;
  bottom: -80rpx;
  left: -42%;
  width: 34%;
  background: linear-gradient(100deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.46), rgba(255, 255, 255, 0));
  transform: rotate(18deg);
  animation: vipGoldShine 4.2s ease-in-out infinite;
}

.member-soon-head,
.member-soon-desc {
  position: relative;
  z-index: 1;
}

.member-soon-head .icon-crown {
  color: #8A4B00;
}

.member-soon-title,
.member-soon-tag {
  color: #6B3A00;
}

.member-soon-title {
  font-weight: 800;
}

.member-soon-tag {
  color: #7C3F00;
  background: rgba(255, 255, 255, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.54);
}

.member-soon-desc {
  color: rgba(107, 58, 0, 0.72);
  font-weight: 600;
}

.profile-ad-wrap {
  display: block;
  margin: 28rpx 0 8rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.profile-section .menu-icon-box {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #E0F2FE 0%, #F0FAFF 100%);
  border: 1rpx solid rgba(56, 189, 248, 0.22);
}

.profile-icon-img,
.setting-icon-img,
.member-crown-img,
.menu-chevron,
.profile-vip-crown-img {
  display: block;
  flex-shrink: 0;
}

.profile-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.setting-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.member-crown-img {
  width: 36rpx;
  height: 36rpx;
}

.menu-chevron {
  width: 34rpx;
  height: 34rpx;
}

.profile-vip-crown-img {
  width: 30rpx;
  height: 30rpx;
}

@keyframes vipGoldShine {
  0%, 46% { transform: translateX(0) rotate(18deg); opacity: 0; }
  56% { opacity: 1; }
  78%, 100% { transform: translateX(420%) rotate(18deg); opacity: 0; }
}
