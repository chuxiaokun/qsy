.mini-app {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F0FAFF;
}

.bg-decor {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.decor {
  position: absolute;
  border-radius: 9999px;
  filter: blur(64rpx);
}

.decor-one {
  top: -256rpx;
  right: -256rpx;
  width: 512rpx;
  height: 512rpx;
  background: rgba(56, 189, 248, 0.12);
}

.decor-two {
  top: 33vh;
  left: -256rpx;
  width: 640rpx;
  height: 640rpx;
  background: rgba(14, 165, 233, 0.22);
}

.decor-three {
  right: 25vw;
  bottom: 256rpx;
  width: 384rpx;
  height: 384rpx;
  background: rgba(56, 189, 248, 0.08);
}

.main {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.section {
  padding: 96rpx 32rpx 48rpx;
}

.center {
  text-align: center;
}

.glass {
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.54);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
}

.glass-strong {
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(60rpx);
  -webkit-backdrop-filter: blur(60rpx);
}

.rounded-xl {
  border-radius: 24rpx;
}

.rounded-2xl {
  border-radius: 32rpx;
}

.rounded-3xl {
  border-radius: 48rpx;
}

.gradient-bg {
  background: linear-gradient(135deg, #0EA5E9 0%, #38BDF8 100%);
}

.shadow-soft {
  box-shadow: 0 8rpx 40rpx -4rpx rgba(18, 50, 74, 0.16), 0 4rpx 16rpx -4rpx rgba(18, 50, 74, 0.12);
}

.shadow-glow {
  box-shadow: 0 0 60rpx rgba(56, 189, 248, 0.32), 0 8rpx 40rpx -4rpx rgba(18, 50, 74, 0.12);
}

.hero {
  margin-bottom: 64rpx;
}

.hero-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 32rpx;
  border-radius: 32rpx;
}

.title,
.page-title {
  display: block;
  color: #12324A;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.title {
  margin-bottom: 16rpx;
}

.subtitle,
.page-desc {
  display: block;
  color: #5E7A8C;
  font-size: 28rpx;
  line-height: 1.5;
}

.mode-card {
  padding: 12rpx;
  margin-bottom: 48rpx;
}

.mode-row {
  display: flex;
}

.mode-btn {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  overflow: hidden;
  color: #5E7A8C;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 24rpx;
}

.mode-active {
  color: #fff;
}

.mode-bg {
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #0EA5E9 0%, #38BDF8 100%);
  box-shadow: 0 8rpx 28rpx rgba(56, 189, 248, 0.22);
}

.mode-icon,
.mode-label {
  position: relative;
  z-index: 1;
}

.input-card {
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.input-col {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.link-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  padding: 0 32rpx;
  color: #12324A;
  font-size: 28rpx;
  background: rgba(255, 250, 240, 0.82);
  border-radius: 24rpx;
}

.placeholder {
  color: #9CB6C6;
}

.clear-btn {
  display: flex;
  flex: none;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  border-radius: 24rpx;
}

.clear-x {
  color: #fff;
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1;
  transform: translateY(-2rpx);
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
}

.submit-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.is-disabled {
  opacity: 0.5;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.36);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.platform-card {
  padding: 32rpx;
}

.result-col {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.result-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #0EA5E9;
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(56, 189, 248, 0.48);
}

.result-status-text {
  color: #12324A;
  font-size: 28rpx;
  font-weight: 600;
}

.result-reset {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 250, 240, 0.72);
  border-radius: 999rpx;
}

.result-reset-icon {
  width: 28rpx;
  height: 28rpx;
  color: #0EA5E9;
}

.result-reset-text {
  color: #0EA5E9;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.result-video {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  background: #000;
}

.result-gallery {
  position: relative;
}

.result-swiper {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(18, 50, 74, 0.06);
}

.result-image {
  width: 100%;
  height: 100%;
}

.result-gallery-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 8rpx 20rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  background: rgba(18, 50, 74, 0.52);
  border-radius: 999rpx;
}

.result-meta {
  padding: 24rpx;
  background: rgba(255, 250, 240, 0.52);
  border-radius: 24rpx;
}

.result-meta-label {
  display: block;
  margin-bottom: 12rpx;
  color: #5E7A8C;
  font-size: 24rpx;
}

.result-title {
  display: block;
  color: #12324A;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.55;
}

.result-actions {
  display: flex;
  gap: 24rpx;
}

.download-progress {
  padding-top: 4rpx;
}

.download-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.download-progress-label {
  color: #5E7A8C;
  font-size: 24rpx;
}

.download-progress-value {
  color: #0EA5E9;
  font-size: 24rpx;
  font-weight: 600;
}

.download-progress-track {
  height: 12rpx;
  overflow: hidden;
  background: rgba(18, 50, 74, 0.72);
  border-radius: 999rpx;
}

.download-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #0EA5E9, #38BDF8);
  border-radius: 999rpx;
  transition: width 0.2s ease;
}

.result-btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 24rpx;
}

.result-btn-outline {
  color: #0EA5E9;
  background: rgba(56, 189, 248, 0.1);
  border: 1rpx solid rgba(56, 189, 248, 0.28);
}

.result-btn.gradient-bg {
  color: #fff;
}

.card-label {
  display: block;
  margin-bottom: 24rpx;
  color: #5E7A8C;
  font-size: 28rpx;
  font-weight: 500;
}

.platform-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.platform-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  padding: 24rpx;
  background: rgba(255, 250, 240, 0.52);
  border-radius: 24rpx;
}

.platform-name {
  color: #12324A;
  font-size: 24rpx;
  font-weight: 500;
}

.platform-dot {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.dot-pink { background: linear-gradient(90deg, #FF6B6B, #FF6B6B); }
.dot-orange { background: linear-gradient(90deg, #f97316, #f59e0b); }
.dot-red { background: linear-gradient(90deg, #ef4444, #FF6B6B); }
.dot-yellow { background: linear-gradient(90deg, #f59e0b, #eab308); }
.dot-blue { background: linear-gradient(90deg, #0F6B93, #38BDF8); }
.dot-green { background: linear-gradient(90deg, #0F6B93, #38BDF8); }

.upload-card {
  padding: 64rpx;
  border: 4rpx dashed rgba(18, 50, 74, 0.8);
}

.upload-inner {
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.upload-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 32rpx;
  background: rgba(255, 250, 240, 0.82);
  border-radius: 32rpx;
}

.upload-title {
  margin-bottom: 8rpx;
  color: #12324A;
  font-size: 32rpx;
  font-weight: 600;
}

.upload-desc {
  margin-bottom: 32rpx;
  color: #5E7A8C;
  font-size: 28rpx;
}

.choose-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 96rpx;
  padding: 0 48rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 24rpx;
}

.tip-card {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
}

.tip-copy {
  flex: 1;
}

.tip-title,
.tip-desc {
  display: block;
}

.tip-title {
  color: #12324A;
  font-size: 28rpx;
  font-weight: 500;
}

.tip-desc {
  margin-top: 8rpx;
  color: #5E7A8C;
  font-size: 24rpx;
  line-height: 1.5;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-top: 48rpx;
}

.stat {
  text-align: center;
}

.stat-value {
  display: block;
  color: #12324A;
  font-size: 36rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  color: #5E7A8C;
  font-size: 24rpx;
}

.divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(18, 50, 74, 0.8);
}

.page-head {
  margin-bottom: 48rpx;
}

.page-title {
  margin-bottom: 16rpx;
}

.promo {
  position: relative;
  min-height: 284rpx;
  padding: 40rpx;
  margin-bottom: 48rpx;
  overflow: hidden;
  border-radius: 32rpx;
}

.promo-orb {
  position: absolute;
  top: -64rpx;
  right: -64rpx;
  width: 256rpx;
  height: 256rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  filter: blur(32rpx);
}

.promo-content {
  position: relative;
  z-index: 1;
}

.promo-kicker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  font-weight: 500;
}

.promo-title {
  display: block;
  margin-bottom: 8rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.promo-desc {
  display: block;
  margin-bottom: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
}

.promo-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 32rpx;
  color: #32b990;
  font-size: 28rpx;
  font-weight: 600;
  background: #fff;
  border-radius: 24rpx;
}

.promo-soon {
  opacity: 0.95;
}

.promo-btn-disabled {
  color: rgba(18, 50, 74, 0.55);
  background: rgba(255, 255, 255, 0.72);
}

.promo-star {
  position: absolute;
  right: 32rpx;
  bottom: 16rpx;
  width: 96rpx;
  height: 96rpx;
  color: rgba(253, 224, 71, 0.34);
  animation: wobble 3s ease-in-out infinite;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 32rpx;
}

.product-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
}

.product-icon-core {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}

.product-copy {
  flex: 1;
  min-width: 0;
}

.product-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  margin-bottom: 4rpx;
}

.product-title {
  color: #12324A;
  font-size: 32rpx;
  font-weight: 600;
}

.product-desc {
  display: block;
  overflow: hidden;
  color: #5E7A8C;
  font-size: 28rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-arrow {
  flex-shrink: 0;
}

.product-bg-violet { background: rgba(139, 92, 246, 0.1); }
.product-bg-pink { background: rgba(236, 72, 153, 0.1); }
.product-bg-sky { background: rgba(255, 184, 0, 0.14); }
.product-bg-amber { background: rgba(245, 158, 11, 0.1); }
.product-bg-emerald { background: rgba(16, 185, 129, 0.1); }
.product-bg-indigo { background: rgba(18, 50, 74, 0.08); }

.product-violet { background: linear-gradient(135deg, #12324A, #0F6B93); }
.product-pink { background: linear-gradient(135deg, #FF6B6B, #FF6B6B); }
.product-sky { background: linear-gradient(135deg, #0F6B93, #0EA5E9); }
.product-amber { background: linear-gradient(135deg, #f59e0b, #f97316); }
.product-emerald { background: linear-gradient(135deg, #0F6B93, #38BDF8); }
.product-indigo { background: linear-gradient(135deg, #12324A, #12324A); }

.bottom-note,
.version {
  display: block;
  margin-top: 48rpx;
  color: #5E7A8C;
  font-size: 24rpx;
  text-align: center;
}

.user-card {
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.profile-action-card {
  margin-bottom: 24rpx;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
}

.avatar-text {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: #e8f0ee;
}

.profile-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(20, 35, 32, 0.45);
}

.notice-modal {
  width: 100%;
  max-width: 620rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.notice-modal-header {
  padding: 36rpx 40rpx 28rpx;
  background: linear-gradient(180deg, #f0f9ff 0%, #e8f4fc 100%);
  border-bottom: 1rpx solid rgba(14, 165, 233, 0.1);
}

.notice-modal-header-text {
  display: block;
  color: #38bdf8;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.notice-modal-body {
  padding: 32rpx 40rpx 40rpx;
  background: rgba(255, 255, 255, 0.96);
}

.notice-modal-content {
  display: block;
  color: #647f92;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.notice-modal-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 36rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  border: none;
  border-radius: 20rpx;
}

.notice-modal-btn::after {
  border: none;
}

.profile-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.profile-modal-title {
  display: block;
  color: #12324A;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.profile-modal-desc {
  display: block;
  margin-top: 16rpx;
  margin-bottom: 32rpx;
  color: #5E7A8C;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.profile-modal-avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 28rpx;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.profile-modal-avatar-btn::after {
  border: none;
}

.profile-modal-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
}

.profile-modal-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #E0F2FE 0%, #F0FAFF 100%);
  border: 2rpx dashed #38BDF8;
  border-radius: 40rpx;
}

.profile-modal-avatar-plus {
  color: #0EA5E9;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.profile-modal-avatar-hint {
  margin-top: 8rpx;
  color: #5E7A8C;
  font-size: 22rpx;
}

.profile-modal-nickname {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-bottom: 28rpx;
  padding: 0 28rpx;
  color: #12324A;
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(45, 159, 122, 0.15);
  border-radius: 20rpx;
}

.profile-modal-save {
  width: 100%;
  height: 88rpx;
  margin-bottom: 16rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  background: linear-gradient(135deg, #0EA5E9 0%, #38BDF8 100%);
  border: none;
  border-radius: 20rpx;
}

.profile-modal-save::after {
  border: none;
}

.profile-modal-skip {
  width: 100%;
  height: 72rpx;
  color: #5E7A8C;
  font-size: 28rpx;
  line-height: 72rpx;
  background: transparent;
  border: none;
}

.profile-modal-skip::after {
  border: none;
}

.profile-modal-save-outline {
  margin-bottom: 16rpx;
  color: #0EA5E9;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid rgba(45, 159, 122, 0.35);
}

.crown-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: #38BDF8;
  border: 4rpx solid #fff;
  border-radius: 50%;
  z-index: 1;
}

.user-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-bottom: 8rpx;
}

.user-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #12324A;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guest-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
