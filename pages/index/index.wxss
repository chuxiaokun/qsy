  z-index: 1;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  opacity: 0.72;
}

.tab-active .tab-text {
  font-weight: 600;
  opacity: 1;
}

.icon {
  display: inline-block;
  position: relative;
  width: 40rpx;
  height: 40rpx;
  color: currentColor;
  flex-shrink: 0;
}

.icon::before,
.icon::after {
  box-sizing: border-box;
}

.icon-white { color: #fff; }
.icon-primary { color: #35bd94; }
.icon-muted { color: #76827f; }
