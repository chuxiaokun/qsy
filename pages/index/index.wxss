.page-fade,
.fade-down,
.fade-in,
.content-slide {
  animation: fadeUp 0.3s ease both;
}

.float-slow {
  animation: rotateFloat 4s ease-in-out infinite;
}

.float-soft {
  animation: floatSoft 2s ease-in-out infinite;
}

.pulse {
  animation: pulse 2s ease-in-out infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes rotateFloat {
  0%, 100% { transform: rotate(0); }
  25% { transform: rotate(5deg); }
  50% { transform: rotate(-5deg); }
}

@keyframes floatSoft {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

@keyframes wobble {
  0%, 100% { transform: rotate(0); }
  30% { transform: rotate(10deg); }
  60% { transform: rotate(-10deg); }
}

/* Summer sky theme */
.mini-app {
  background: #F0FAFF;
}

.bg-decor {
  background:
    linear-gradient(180deg, #D8F3FF 0%, #E0F2FE 260rpx, #F0FAFF 520rpx, #F0FAFF 100%),
    linear-gradient(135deg, rgba(14, 165, 233, 0.12), rgba(18, 50, 74, 0.08));
}

.decor {
  display: none;
}

.main {
  padding-bottom: calc(188rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(188rpx + env(safe-area-inset-bottom));
}

.section {
  padding: 52rpx 28rpx 44rpx;
}

.glass {
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(18, 50, 74, 0.08);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}

.glass-strong {
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(18, 50, 74, 0.1);
