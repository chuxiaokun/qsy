.mini-app {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #f7fcfa;
}

.bg-decor {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.decor {
  position: absolute;
  border-radius: 9999px;
  filter: blur(64rpx);
}

.decor-one {
  top: -256rpx;
  right: -256rpx;
  width: 512rpx;
  height: 512rpx;
  background: rgba(64, 199, 159, 0.12);
}

.decor-two {
  top: 33vh;
  left: -256rpx;
  width: 640rpx;
  height: 640rpx;
  background: rgba(137, 222, 235, 0.22);
}

.decor-three {
  right: 25vw;
  bottom: 256rpx;
  width: 384rpx;
  height: 384rpx;
  background: rgba(64, 199, 159, 0.08);
}

.main {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.section {
  padding: 96rpx 32rpx 48rpx;
}

.center {
  text-align: center;
}

.glass {
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.54);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
}

.glass-strong {
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(60rpx);
  -webkit-backdrop-filter: blur(60rpx);
}

.rounded-xl {
  border-radius: 24rpx;
}

.rounded-2xl {
  border-radius: 32rpx;
}

.rounded-3xl {
  border-radius: 48rpx;
}

.gradient-bg {
  background: linear-gradient(135deg, #58cfa3 0%, #83d6e5 100%);
}

.shadow-soft {
  box-shadow: 0 8rpx 40rpx -4rpx rgba(78, 137, 128, 0.16), 0 4rpx 16rpx -4rpx rgba(78, 137, 128, 0.12);
}

.shadow-glow {
  box-shadow: 0 0 60rpx rgba(64, 199, 159, 0.32), 0 8rpx 40rpx -4rpx rgba(78, 137, 128, 0.12);
}

.hero {
  margin-bottom: 64rpx;
}

.hero-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 32rpx;
  border-radius: 32rpx;
}

.title,
.page-title {
  display: block;
  color: #2f3b39;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.title {
  margin-bottom: 16rpx;
}

.subtitle,
.page-desc {
  display: block;
  color: #76827f;
  font-size: 28rpx;
  line-height: 1.5;
}

.mode-card {
  padding: 12rpx;
  margin-bottom: 48rpx;
}

.mode-row {
  display: flex;
}

.mode-btn {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  overflow: hidden;
  color: #76827f;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 24rpx;
}

.mode-active {
  color: #fff;
}

.mode-bg {
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #58cfa3 0%, #83d6e5 100%);
  box-shadow: 0 8rpx 28rpx rgba(64, 199, 159, 0.22);
}

.mode-icon,
.mode-label {
  position: relative;
  z-index: 1;
}

.input-card {
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.input-col {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.input-wrap {
  position: relative;
  flex: 1;
}

.link-input {
  width: 100%;
  height: 96rpx;
  padding: 0 76rpx 0 32rpx;
  color: #2f3b39;
  font-size: 28rpx;
  background: rgba(235, 246, 247, 0.82);
  border-radius: 24rpx;
}

.placeholder {
  color: #87928f;
}

.clear-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  color: #76827f;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
}

.submit-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.is-disabled {
  opacity: 0.5;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.36);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.platform-card {
  padding: 32rpx;
}

.result-col {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.result-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #35bd94;
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(53, 189, 148, 0.48);
}

.result-status-text {
  color: #2f3b39;
  font-size: 28rpx;
  font-weight: 600;
}

.result-reset {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(235, 246, 247, 0.72);
  border-radius: 999rpx;
}

.result-reset-icon {
  width: 28rpx;
  height: 28rpx;
  color: #35bd94;
}

.result-reset-text {
  color: #35bd94;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.result-video {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  background: #000;
}

.result-gallery {
  position: relative;
}

.result-swiper {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(47, 59, 57, 0.06);
}

.result-image {
  width: 100%;
  height: 100%;
}

.result-gallery-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 8rpx 20rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  background: rgba(47, 59, 57, 0.52);
  border-radius: 999rpx;
}

.result-meta {
  padding: 24rpx;
  background: rgba(235, 246, 247, 0.52);
  border-radius: 24rpx;
}

.result-meta-label {
  display: block;
  margin-bottom: 12rpx;
  color: #76827f;
  font-size: 24rpx;
}

.result-title {
  display: block;
  color: #2f3b39;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.55;
}

.result-actions {
  display: flex;
  gap: 24rpx;
}

.download-progress {
  padding-top: 4rpx;
}

.download-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.download-progress-label {
  color: #76827f;
  font-size: 24rpx;
}

.download-progress-value {
  color: #35bd94;
  font-size: 24rpx;
  font-weight: 600;
}

.download-progress-track {
  height: 12rpx;
  overflow: hidden;
  background: rgba(206, 224, 224, 0.72);
  border-radius: 999rpx;
}

.download-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #58cfa3, #83d6e5);
  border-radius: 999rpx;
  transition: width 0.2s ease;
}

.result-btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 24rpx;
}

.result-btn-outline {
  color: #35bd94;
  background: rgba(64, 199, 159, 0.1);
  border: 1rpx solid rgba(64, 199, 159, 0.28);
}

.result-btn.gradient-bg {
  color: #fff;
}

.card-label {
  display: block;
  margin-bottom: 24rpx;
  color: #76827f;
  font-size: 28rpx;
  font-weight: 500;
}

.platform-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.platform-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  padding: 24rpx;
  background: rgba(235, 246, 247, 0.52);
  border-radius: 24rpx;
}

.platform-name {
  color: #2f3b39;
  font-size: 24rpx;
  font-weight: 500;
}

.platform-dot {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.dot-pink { background: linear-gradient(90deg, #ec4899, #f43f5e); }
.dot-orange { background: linear-gradient(90deg, #f97316, #f59e0b); }
.dot-red { background: linear-gradient(90deg, #ef4444, #ec4899); }
.dot-yellow { background: linear-gradient(90deg, #f59e0b, #eab308); }
.dot-blue { background: linear-gradient(90deg, #0ea5e9, #06b6d4); }
.dot-green { background: linear-gradient(90deg, #10b981, #14b8a6); }

.upload-card {
  padding: 64rpx;
  border: 4rpx dashed rgba(206, 224, 224, 0.8);
}

.upload-inner {
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.upload-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 32rpx;
  background: rgba(235, 246, 247, 0.82);
  border-radius: 32rpx;
}

.upload-title {
  margin-bottom: 8rpx;
  color: #2f3b39;
  font-size: 32rpx;
  font-weight: 600;
}

.upload-desc {
  margin-bottom: 32rpx;
  color: #76827f;
  font-size: 28rpx;
}

.choose-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 96rpx;
  padding: 0 48rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 24rpx;
}

.tip-card {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
}

.tip-copy {
  flex: 1;
}

.tip-title,
.tip-desc {
  display: block;
}

.tip-title {
  color: #2f3b39;
  font-size: 28rpx;
  font-weight: 500;
}

.tip-desc {
  margin-top: 8rpx;
  color: #76827f;
  font-size: 24rpx;
  line-height: 1.5;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-top: 48rpx;
}

.stat {
  text-align: center;
}

.stat-value {
  display: block;
  color: #2f3b39;
  font-size: 36rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  color: #76827f;
  font-size: 24rpx;
}

.divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(206, 224, 224, 0.8);
}

.page-head {
  margin-bottom: 48rpx;
}

.page-title {
  margin-bottom: 16rpx;
}

.promo {
  position: relative;
  min-height: 284rpx;
  padding: 40rpx;
  margin-bottom: 48rpx;
  overflow: hidden;
  border-radius: 32rpx;
}

.promo-orb {
  position: absolute;
  top: -64rpx;
  right: -64rpx;
  width: 256rpx;
  height: 256rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  filter: blur(32rpx);
}

.promo-content {
  position: relative;
  z-index: 1;
}

.promo-kicker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  font-weight: 500;
}

.promo-title {
  display: block;
  margin-bottom: 8rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.promo-desc {
  display: block;
  margin-bottom: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
}

.promo-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 32rpx;
  color: #32b990;
  font-size: 28rpx;
  font-weight: 600;
  background: #fff;
  border-radius: 24rpx;
}

.promo-soon {
  opacity: 0.95;
}

.promo-btn-disabled {
  color: rgba(47, 59, 57, 0.55);
  background: rgba(255, 255, 255, 0.72);
}

.promo-star {
  position: absolute;
  right: 32rpx;
  bottom: 16rpx;
  width: 96rpx;
  height: 96rpx;
  color: rgba(253, 224, 71, 0.34);
  animation: wobble 3s ease-in-out infinite;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 32rpx;
}

.product-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
}

.product-icon-core {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}

.product-copy {
  flex: 1;
  min-width: 0;
}

.product-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  margin-bottom: 4rpx;
}

.product-title {
  color: #2f3b39;
  font-size: 32rpx;
  font-weight: 600;
}

.product-desc {
  display: block;
  overflow: hidden;
  color: #76827f;
  font-size: 28rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-arrow {
  flex-shrink: 0;
}

.product-bg-violet { background: rgba(139, 92, 246, 0.1); }
.product-bg-pink { background: rgba(236, 72, 153, 0.1); }
.product-bg-sky { background: rgba(14, 165, 233, 0.1); }
.product-bg-amber { background: rgba(245, 158, 11, 0.1); }
.product-bg-emerald { background: rgba(16, 185, 129, 0.1); }
.product-bg-indigo { background: rgba(99, 102, 241, 0.1); }

.product-violet { background: linear-gradient(135deg, #8b5cf6, #a855f7); }
.product-pink { background: linear-gradient(135deg, #ec4899, #f43f5e); }
.product-sky { background: linear-gradient(135deg, #0ea5e9, #3b82f6); }
.product-amber { background: linear-gradient(135deg, #f59e0b, #f97316); }
.product-emerald { background: linear-gradient(135deg, #10b981, #14b8a6); }
.product-indigo { background: linear-gradient(135deg, #6366f1, #8b5cf6); }

.bottom-note,
.version {
  display: block;
  margin-top: 48rpx;
  color: #76827f;
  font-size: 24rpx;
  text-align: center;
}

.user-card {
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.profile-action-card {
  margin-bottom: 24rpx;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
}

.avatar-text {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: #e8f0ee;
}

.profile-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(20, 35, 32, 0.45);
}

.profile-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.profile-modal-title {
  display: block;
  color: #2f3b39;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.profile-modal-desc {
  display: block;
  margin-top: 16rpx;
  margin-bottom: 32rpx;
  color: #6b7c78;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.profile-modal-avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 28rpx;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.profile-modal-avatar-btn::after {
  border: none;
}

.profile-modal-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
}

.profile-modal-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #e8faf4 0%, #d4f0e8 100%);
  border: 2rpx dashed #9fd4c4;
  border-radius: 40rpx;
}

.profile-modal-avatar-plus {
  color: #2d9f7a;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.profile-modal-avatar-hint {
  margin-top: 8rpx;
  color: #6b7c78;
  font-size: 22rpx;
}

.profile-modal-nickname {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-bottom: 28rpx;
  padding: 0 28rpx;
  color: #2f3b39;
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(45, 159, 122, 0.15);
  border-radius: 20rpx;
}

.profile-modal-save {
  width: 100%;
  height: 88rpx;
  margin-bottom: 16rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  background: linear-gradient(135deg, #2d9f7a 0%, #3bb88e 100%);
  border: none;
  border-radius: 20rpx;
}

.profile-modal-save::after {
  border: none;
}

.profile-modal-skip {
  width: 100%;
  height: 72rpx;
  color: #6b7c78;
  font-size: 28rpx;
  line-height: 72rpx;
  background: transparent;
  border: none;
}

.profile-modal-skip::after {
  border: none;
}

.crown-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: #facc15;
  border: 4rpx solid #fff;
  border-radius: 50%;
  z-index: 1;
}

.user-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-bottom: 8rpx;
}

.user-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #2f3b39;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guest-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  color: #76827f;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
  background: rgba(118, 130, 127, 0.12);
  border-radius: 999rpx;
}

.user-email {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #35bd94;
  font-size: 24rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-id {
  display: block;
  overflow: hidden;
  color: #76827f;
  font-size: 28rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  background: rgba(235, 246, 247, 0.72);
  border-radius: 24rpx;
}

.member-soon-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #fefce8 100%);
  border: 1rpx solid rgba(252, 211, 77, 0.45);
}

.member-soon-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.member-soon-title {
  flex: 1;
  min-width: 0;
  color: #b45309;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.member-soon-tag {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  color: #b45309;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  background: rgba(251, 191, 36, 0.32);
  border-radius: 999rpx;
