<view class="mini-app">
  <view class="bg-decor">
    <view class="decor decor-one"></view>
    <view class="decor decor-two"></view>
    <view class="decor decor-three"></view>
  </view>

  <view class="main page-fade" style="padding-top: {{statusBarHeight}}px;">
    <view wx:if="{{activeTab === 'remove'}}" class="section page-section">
      <view class="hero center fade-down">
        <view class="hero-icon gradient-bg shadow-glow float-slow">
          <view class="icon icon-sparkles icon-white"></view>
        </view>
        <text class="title">去水印</text>
        <text class="subtitle">粘贴链接，一键解析无水印内容</text>
      </view>

      <view class="content-slide">
        <view class="glass rounded-2xl input-card shadow-soft">
          <view wx:if="{{!showParseResult}}" class="input-col">
            <view class="input-wrap">
              <input class="link-input" value="{{linkInput}}" bindinput="onLinkInput" placeholder="粘贴视频/图片链接..." placeholder-class="placeholder" />
              <view wx:if="{{linkInput}}" class="clear-btn gradient-bg shadow-soft" bindtap="clearLink">
                <text class="clear-x">×</text>
              </view>
            </view>
            <button class="submit-btn gradient-bg shadow-soft {{(!linkInput || isProcessing) ? 'is-disabled' : ''}}" bindtap="handleProcess">
              <view wx:if="{{isProcessing}}" class="spinner"></view>
              <text wx:else class="submit-text">立即解析</text>
            </button>
          </view>

          <view wx:else class="result-col content-slide">
            <view class="result-head">
              <view class="result-status">
                <view class="result-status-dot"></view>
                <text class="result-status-text">解析完成</text>
              </view>
              <view class="result-reset" bindtap="continueParse">
                <view class="icon icon-link result-reset-icon"></view>
                <text class="result-reset-text">解析其他链接</text>
              </view>
            </view>

            <video
              wx:if="{{parseResult.videoUrl}}"
              class="result-video"
              src="{{parseResult.videoUrl}}"
              controls
              show-center-play-btn
              object-fit="contain"
            />

            <view wx:elif="{{images.length}}" class="result-gallery">
              <swiper
                class="result-swiper"
                current="{{imageCurrent}}"
                bindchange="onImageSwiperChange"
                circular="{{images.length > 1}}"
                indicator-dots="{{images.length > 1}}"
                indicator-color="rgba(255,255,255,0.4)"
                indicator-active-color="#35bd94"
              >
                <swiper-item wx:for="{{images}}" wx:key="url">
                  <image
                    class="result-image"
                    src="{{item.url}}"
                    mode="aspectFit"
                    bindtap="previewImages"
                  />
                </swiper-item>
              </swiper>
              <text wx:if="{{images.length > 1}}" class="result-gallery-count">{{imageCurrent + 1}} / {{images.length}}</text>
            </view>

            <view class="result-meta">
              <text class="result-meta-label">{{parseResult.videoUrl ? '视频标题' : '作品标题'}}</text>
              <text class="result-title">{{parseResult.title}}</text>
            </view>

            <view class="result-actions">
              <button class="result-btn gradient-bg shadow-soft {{isSavingVideo ? 'is-disabled' : ''}}" bindtap="saveVideo" disabled="{{isSavingVideo}}">
                {{isSavingVideo ? '保存中...' : '保存到相册'}}
              </button>
              <button wx:if="{{hasLivePhoto}}" class="result-btn result-btn-outline {{isSavingLive ? 'is-disabled' : ''}}" bindtap="saveLivePhotos" disabled="{{isSavingLive}}">
                {{isSavingLive ? '保存中...' : '保存 Live Photo'}}
              </button>
              <button class="result-btn result-btn-outline" bindtap="copyTitle">复制标题</button>
            </view>

            <view wx:if="{{showDownloadProgress}}" class="download-progress">
              <view class="download-progress-head">
                <text class="download-progress-label">{{downloadPhase === 'saving' ? '正在写入相册' : (parseResult.videoUrl ? '正在下载视频' : '正在下载图片')}}</text>
                <text class="download-progress-value">{{downloadProgress}}%</text>
              </view>
              <view class="download-progress-track">
                <view class="download-progress-bar" style="width: {{downloadProgress}}%;"></view>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{!showParseResult}}" class="glass rounded-2xl platform-card shadow-soft">
          <text class="card-label">支持的平台</text>
          <view class="platform-grid">
            <view class="platform-item" wx:for="{{platforms}}" wx:key="id">
              <view class="platform-dot {{item.dotClass}}"></view>
              <text class="platform-name">{{item.name}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="stats-row">
        <view class="stat">
          <text class="stat-value">128.5K</text>
          <text class="stat-label">今日处理</text>
        </view>
        <view class="divider"></view>
        <view class="stat">
          <text class="stat-value">99.8%</text>
          <text class="stat-label">成功率</text>
        </view>
        <view class="divider"></view>
        <view class="stat">
          <text class="stat-value">1.3s</text>
          <text class="stat-label">平均耗时</text>
        </view>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'products'}}" class="section page-section">
      <view class="page-head fade-down">
        <text class="page-title">更多产品</text>
        <text class="page-desc">发现更多实用工具</text>
      </view>

      <view class="promo promo-soon gradient-bg shadow-glow" bindtap="onComingSoon">
        <view class="promo-orb"></view>
        <view class="promo-content">
          <view class="promo-kicker">
            <view class="icon icon-zap icon-yellow icon-small"></view>
            <text>即将上线</text>
          </view>
          <text class="promo-title">会员尊享全部功能</text>
          <text class="promo-desc">个人主体小程序暂不支持支付，会员功能筹备中</text>
          <view class="promo-btn promo-btn-disabled">
            <text>敬请期待</text>
          </view>
        </view>
        <view class="icon icon-star promo-star"></view>
      </view>

        <view class="product-list">
        <view class="glass rounded-2xl product-card shadow-soft" wx:for="{{products}}" wx:key="id" data-page="{{item.page}}" bindtap="onProductTap">
          <view class="product-icon-wrap {{item.bgClass}}">
            <view class="product-icon-core {{item.colorClass}}">
              <view class="icon {{item.iconClass}} icon-white icon-product"></view>
            </view>
          </view>
          <view class="product-copy">
            <view class="product-title-row">
              <text class="product-title">{{item.name}}</text>
              <text wx:if="{{item.badge}}" class="badge {{item.badgeClass}}">{{item.badge}}</text>
            </view>
            <text class="product-desc">{{item.description}}</text>
          </view>
          <view class="icon icon-arrow-right icon-muted product-arrow"></view>
        </view>
      </view>

      <text class="bottom-note">更多工具持续上线中...</text>
    </view>

    <view wx:else class="section page-section profile-section">
      <view class="glass rounded-3xl user-card shadow-soft fade-down">
        <view class="user-row">
          <view class="avatar-wrap">
            <image wx:if="{{user.avatarUrl}}" class="avatar avatar-img shadow-glow" src="{{user.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="avatar gradient-bg shadow-glow">
              <text class="avatar-text">{{userInitial}}</text>
            </view>
          </view>
          <view class="user-info">
            <view class="name-row">
              <text class="user-name">{{user.nickname || '游客'}}</text>
              <text wx:if="{{user.isGuest}}" class="guest-badge">游客</text>
            </view>
            <text class="user-id">ID: {{userDisplayId}}</text>
            <text wx:if="{{emailBound}}" class="user-email">{{user.email}}</text>
          </view>
        </view>
      </view>

      <view class="glass rounded-2xl menu-card shadow-soft profile-action-card">
        <view class="menu-item" bindtap="goBindEmail">
          <view class="menu-icon-box">
            <view class="icon icon-mail icon-primary icon-menu"></view>
          </view>
          <view class="menu-copy">
            <text class="menu-title">绑定邮箱</text>
            <text class="menu-desc">{{emailBound ? '已绑定，点击查看' : '绑定后可接收通知与找回账号'}}</text>
          </view>
          <view class="icon icon-chevron-right icon-muted icon-small"></view>
        </view>
      </view>

      <view class="glass rounded-2xl member-soon-card shadow-soft" bindtap="onComingSoon">
        <view class="member-soon-head">
          <view class="icon icon-crown icon-amber icon-small"></view>
          <text class="member-soon-title">{{isVip ? 'VIP 会员' : '开通 VIP'}}</text>
          <text class="member-soon-tag">{{isVip ? '已开通' : '联系客服'}}</text>
        </view>
        <text class="member-soon-desc">{{isVip ? '尊享永久免广告与全部功能' : '请联系客服开通会员'}}</text>
      </view>

      <view class="glass rounded-2xl usage-card shadow-soft">
        <view class="usage-item">
          <text class="usage-value">{{usageCount}}</text>
          <text class="usage-label">处理次数</text>
        </view>
        <view class="usage-item">
          <text class="usage-value">—</text>
          <text class="usage-label">节省时间</text>
        </view>
        <view class="usage-item">
          <text class="usage-value">—</text>
          <text class="usage-label">连续使用</text>
        </view>
      </view>

      <view class="glass rounded-2xl menu-card shadow-soft">
        <view class="menu-item {{index !== menuItems.length - 1 ? 'has-border' : ''}}" wx:for="{{menuItems}}" wx:key="id" data-id="{{item.id}}" bindtap="onMenuTap">
          <view class="menu-icon-box">
            <view class="icon {{item.iconClass}} icon-primary icon-menu"></view>
          </view>
          <view class="menu-copy">
            <text class="menu-title">{{item.name}}</text>
            <text class="menu-desc">{{item.description}}</text>
          </view>
          <view class="menu-right">
            <text wx:if="{{item.badge}}" class="badge {{item.badgeClass}}">{{item.badge}}</text>
            <view class="icon icon-chevron-right icon-muted icon-small"></view>
          </view>
        </view>
      </view>

      <view class="glass rounded-2xl menu-card shadow-soft settings-card">
        <view class="setting-item {{index !== settingsItems.length - 1 ? 'has-border' : ''}}" wx:for="{{settingsItems}}" wx:key="id">
          <view class="icon {{item.iconClass}} icon-muted icon-setting"></view>
          <text class="setting-title">{{item.name}}</text>
          <view class="icon icon-chevron-right icon-muted icon-small"></view>
        </view>
      </view>

      <text class="version">{{appVersion}}</text>
    </view>
  </view>

  <view wx:if="{{showUnlockModal}}" class="profile-modal-mask" catchtouchmove="preventUnlockModalMove">
    <view class="profile-modal glass rounded-2xl shadow-soft">
      <text class="profile-modal-title">解锁今日去水印</text>
      <text class="profile-modal-desc">观看一段激励视频，即可解锁今日保存与完整使用权限；开通 VIP 永久免广告。</text>
      <button class="profile-modal-save" bindtap="onWatchAdUnlock" loading="{{adUnlockLoading}}" disabled="{{adUnlockLoading}}">
        看广告解锁今日
      </button>
      <button class="profile-modal-save profile-modal-save-outline" bindtap="onUnlockGoVip">开通 VIP</button>
      <button class="profile-modal-skip" bindtap="onDismissUnlockModal">稍后再说</button>
    </view>
  </view>

  <view wx:if="{{showVipContactModal}}" class="profile-modal-mask" catchtouchmove="preventUnlockModalMove">
    <view class="profile-modal glass rounded-2xl shadow-soft">
      <text class="profile-modal-title">开通 VIP</text>
      <text class="profile-modal-desc">请联系客服开通 VIP 会员，尊享永久免广告与全部功能。</text>
      <button class="profile-modal-save" bindtap="onCloseVipContactModal">知道了</button>
    </view>
  </view>

  <view wx:if="{{showProfileModal}}" class="profile-modal-mask" catchtouchmove="preventModalMove">
    <view class="profile-modal glass rounded-2xl shadow-soft">
      <text class="profile-modal-title">完善个人资料</text>
      <text class="profile-modal-desc">选择头像并填写昵称，用于个人中心展示</text>
      <button class="profile-modal-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onModalChooseAvatar">
        <image wx:if="{{modalAvatarUrl}}" class="profile-modal-avatar-img" src="{{modalAvatarUrl}}" mode="aspectFill" />
        <view wx:else class="profile-modal-avatar-placeholder">
          <text class="profile-modal-avatar-plus">+</text>
          <text class="profile-modal-avatar-hint">选择头像</text>
        </view>
      </button>
      <input
        class="profile-modal-nickname"
        type="nickname"
        placeholder="请输入昵称"
        value="{{modalNickname}}"
        bindinput="onModalNicknameInput"
        bindblur="onModalNicknameBlur"
      />
      <button class="profile-modal-save" bindtap="onSaveProfile" loading="{{profileSaving}}" disabled="{{profileSaving}}">
        保存
      </button>
      <button class="profile-modal-skip" bindtap="onDismissProfileModal">稍后再说</button>
    </view>
  </view>

  <view class="tabbar">
    <view class="glass-strong rounded-2xl tabbar-inner shadow-soft">
      <button class="tab-item {{activeTab === 'remove' ? 'tab-active' : ''}}" data-tab="remove" bindtap="switchTab">
        <view wx:if="{{activeTab === 'remove'}}" class="tab-active-bg"></view>
        <view class="icon icon-droplets tab-icon"></view>
        <text class="tab-text">去水印</text>
      </button>
      <button class="tab-item {{activeTab === 'products' ? 'tab-active' : ''}}" data-tab="products" bindtap="switchTab">
        <view wx:if="{{activeTab === 'products'}}" class="tab-active-bg"></view>
        <view class="icon icon-grid tab-icon"></view>
        <text class="tab-text">更多产品</text>
      </button>
      <button class="tab-item {{activeTab === 'profile' ? 'tab-active' : ''}}" data-tab="profile" bindtap="switchTab">
        <view wx:if="{{activeTab === 'profile'}}" class="tab-active-bg"></view>
        <view class="icon icon-user tab-icon"></view>
        <text class="tab-text">个人中心</text>
      </button>
    </view>
  </view>
</view>
